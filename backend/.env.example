# Copie este arquivo para ".env" e preencha com os seus dados.
# NUNCA envie o arquivo .env para o GitHub.

# String de conexão do MongoDB Atlas (Connect > Drivers), com a senha do usuário do banco
STRING_CONEXAO=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nome do banco de dados
NOME_BANCO=edu_imobiliaria

# Senha da área administrativa do site (escolha uma senha forte)
SENHA_ADMIN=troque-esta-senha

# Endereço do front-end publicado (para o CORS). Deixe vazio para liberar todos.
FRONTEND_URL=

# Use "true" só se aparecer o erro "querySrv ECONNREFUSED" ao conectar no seu computador
DNS_PUBLICO=
